    "test:zoho-inventory": "node --env-file=.env scripts/testZohoInventory.js",
    "sync:zoho-products": "node scripts/syncZohoProducts.js",
    "sync:zoho-products:dry-run": "node scripts/syncZohoProducts.js --dry-run --limit=10",
    "sync:zoho-products:test": "node scripts/syncZohoProducts.js --dry-run --limit=3 --skip-images"
  },
  "engines": {
    "node": "22.x"
  },
