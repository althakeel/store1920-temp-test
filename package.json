{
  "name": "store1920",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "dev:webpack": "next dev --webpack -p 3000",
    "dev:clean": "node scripts/clean-next-cache.js && next dev --webpack -p 3000",
    "dev:restart": "node scripts/kill-port-3000.js 3000 && node scripts/clean-next-cache.js && next dev --webpack -p 3000",
    "clean": "node scripts/clean-next-cache.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "migrate:product-images-s3": "node scripts/migrateProductImagesToS3.js",
    "migrate:product-images-s3:dry-run": "node scripts/migrateProductImagesToS3.js --dry-run",
    "migrate:categories": "node scripts/migrateCategories.mjs --no-backup",
